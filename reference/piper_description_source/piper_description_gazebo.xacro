    <!-- Piper joint6/link6 上的 RGB-D 摄像头 -->
  <link name="piper_camera_link">

    <!-- 不使用 camera.dae，使用简单几何体表示外壳 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.025"/>
      </geometry>
      <material name="piper_camera_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>
  </link>

  <!-- 将摄像头固定到 Piper 的 link6 -->
  <joint name="piper_camera_joint" type="fixed">
    <parent link="piper_link6"/>
    <child link="piper_camera_link"/>

    <!--
      x 方向：从 link6 向前伸出 8 cm
      z 方向：向上偏移 6 cm
      这个姿态是初始值，之后根据 Gazebo 中的方向调整
    -->
    <origin xyz="-0.06 0 0.04" rpy="0 -1.2 0"/>
  </joint>
  
  <!-- 相机光学坐标：X 向右，Y 向下，Z 向前 -->
  <link name="piper_camera_optical_frame"/>

  <joint name="piper_camera_optical_joint" type="fixed">
    <parent link="piper_camera_link"/>
    <child link="piper_camera_optical_frame"/>
    <origin
      xyz="0 0 0"
      rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <!-- Gazebo RGB-D 相机 -->
  <gazebo reference="piper_camera_link">
    <sensor type="depth" name="piper_dabai_dcw_camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
      </camera>

      <plugin
        name="piper_camera_controller"
        filename="libgazebo_ros_openni_kinect.so">

        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>

        <!-- 独立命名空间，避免和 Scout 摄像头冲突 -->
        <cameraName>piper_camera</cameraName>
        <robotNamespace>/piper_camera</robotNamespace>

        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>

        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>

        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>piper_camera_optical_frame</frameName>

        <pointCloudCutoff>0.10</pointCloudCutoff>
        <pointCloudCutoffMax>10.0</pointCloudCutoffMax>

        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

<!-- controller -->
  <xacro:macro name="transmission_block" params="tran_name joint_name motor_name">
    <transmission name="${tran_name}">
        <type>transmission_interface/SimpleTransmission</type>
        <joint name="${joint_name}">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        </joint>
        <actuator name="${motor_name}">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            <mechanicalReduction>1</mechanicalReduction>
        </actuator>
    </transmission>
  </xacro:macro>

  <xacro:transmission_block tran_name="piper_tran1" joint_name="piper_joint1" motor_name="piper_motor1"/>
  <xacro:transmission_block tran_name="piper_tran2" joint_name="piper_joint2" motor_name="piper_motor2"/>
  <xacro:transmission_block tran_name="piper_tran3" joint_name="piper_joint3" motor_name="piper_motor3"/>
  <xacro:transmission_block tran_name="piper_tran4" joint_name="piper_joint4" motor_name="piper_motor4"/>
  <xacro:transmission_block tran_name="piper_tran5" joint_name="piper_joint5" motor_name="piper_motor5"/>
  <xacro:transmission_block tran_name="piper_tran6" joint_name="piper_joint6" motor_name="piper_motor6"/>
  <xacro:transmission_block tran_name="piper_tran7" joint_name="piper_joint7" motor_name="piper_motor7"/>
  <xacro:transmission_block tran_name="piper_tran8" joint_name="piper_joint8" motor_name="piper_motor8"/>
