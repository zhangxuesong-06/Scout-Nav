<?xml version="1.0"?>
<!-- Simulation geometry adapted from reference/demo_scout/scout_description/urdf/mini.xacro.
     Original copyrights and BSD terms are retained in reference/demo_scout.
     All dimensions here are simulation values, NOT measured hardware extrinsics. -->
<robot name="scout_mini" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="mesh_root" default=""/>
  <xacro:arg name="camera_pitch" default="0.0"/>
  <xacro:property name="chassis_height" value="0.260998"/>
  <xacro:property name="wheelbase" value="0.463951"/>
  <xacro:property name="track" value="0.416503"/>
  <xacro:property name="radius" value="0.16"/>
  <link name="base_link"/>
  <link name="chassis_link">
    <inertial><mass value="60"/><inertia ixx="2.288641" iyy="5.103976" izz="3.431465" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin rpy="${pi/2} 0 ${pi/2}"/><geometry><mesh filename="$(arg mesh_root)/scout_mini_base_link2.dae"/></geometry></visual>
    <collision><geometry><box size="0.56 0.39 0.18"/></geometry></collision>
  </link>
  <joint name="chassis_joint" type="fixed"><parent link="base_link"/><child link="chassis_link"/><origin xyz="0 0 ${chassis_height}"/></joint>
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <inertial><mass value="3"/><inertia ixx="0.0208" iyy="0.0208" izz="0.0384" ixy="0" ixz="0" iyz="0"/></inertial>
      <!-- Original mesh radius is ~0.08m. Scale/recenter its visual to match
           the original mini.xacro declared 0.16m physics radius. -->
      <visual><origin xyz="0 0 -0.01152"/><geometry><mesh filename="$(arg mesh_root)/wheel.dae" scale="2 2 0.60606"/></geometry></visual>
      <collision><geometry><cylinder radius="${radius}" length="0.08"/></geometry></collision>
    </link>
    <joint name="${prefix}_wheel" type="continuous"><parent link="base_link"/><child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${radius}" rpy="${-pi/2} 0 0"/><axis xyz="0 0 1"/>
      <limit effort="50" velocity="15"/><dynamics damping="0.02"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link"><mu1>0.8</mu1><mu2>0.4</mu2></gazebo>
  </xacro:macro>
  <xacro:macro name="wheel_slip" params="prefix">
    <wheel link_name="${prefix}_wheel_link"><wheel_radius>${radius}</wheel_radius>
      <slip_compliance_lateral>0.5</slip_compliance_lateral><slip_compliance_longitudinal>0.001</slip_compliance_longitudinal>
      <wheel_normal_force>205</wheel_normal_force></wheel>
  </xacro:macro>
  <xacro:wheel prefix="front_left" x="${wheelbase/2}" y="${track/2}"/>
  <xacro:wheel prefix="rear_left" x="${-wheelbase/2}" y="${track/2}"/>
  <xacro:wheel prefix="front_right" x="${wheelbase/2}" y="${-track/2}"/>
  <xacro:wheel prefix="rear_right" x="${-wheelbase/2}" y="${-track/2}"/>
  <link name="arm_mount">
    <inertial><mass value="5"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.22 0.27 0.44"/></geometry><material name="aluminium"><color rgba="0.7 0.7 0.72 1"/></material></visual>
    <collision><geometry><box size="0.22 0.27 0.44"/></geometry></collision>
  </link>
  <joint name="arm_mount_joint" type="fixed"><parent link="chassis_link"/><child link="arm_mount"/><origin xyz="0.08 0 0.24"/></joint>
  <xacro:include filename="piper_passive.urdf.xacro"/>
  <joint name="piper_mount_joint" type="fixed"><parent link="arm_mount"/><child link="piper_base_link"/><origin xyz="-0.06 0 0.22"/></joint>
  <link name="nav_camera_link">
    <inertial><mass value="0.25"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.03 0.09 0.025"/></geometry><material name="camera_black"><color rgba="0.18 0.18 0.18 1"/></material></visual>
  </link>
  <joint name="nav_camera_joint" type="fixed"><parent link="chassis_link"/><child link="nav_camera_link"/><origin xyz="0.20 0 0.45" rpy="0 $(arg camera_pitch) 0"/></joint>
  <link name="nav_camera_color_optical_frame"/>
  <joint name="nav_camera_optical_joint" type="fixed"><parent link="nav_camera_link"/><child link="nav_camera_color_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <gazebo reference="nav_camera_link">
    <sensor name="nav_rgbd" type="rgbd_camera">
      <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
      <topic>/scout_sim/camera</topic>
      <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>10</far></clip></camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint><left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint><right_joint>rear_right_wheel</right_joint>
      <wheel_separation>${track}</wheel_separation><wheel_radius>${radius}</wheel_radius>
      <topic>/scout_sim/drive_cmd</topic><odom_topic>/scout_sim/odom</odom_topic><tf_topic>/scout_sim/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.3</max_linear_velocity><min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>0.6</max_angular_velocity><min_angular_velocity>-0.6</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/scout_sim/joint_states</topic>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/scout_sim/ground_truth</odom_topic><odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame><dimensions>3</dimensions><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-wheel-slip-system" name="ignition::gazebo::systems::WheelSlip">
      <xacro:wheel_slip prefix="front_left"/><xacro:wheel_slip prefix="rear_left"/>
      <xacro:wheel_slip prefix="front_right"/><xacro:wheel_slip prefix="rear_right"/>
    </plugin>
  </gazebo>
</robot>
