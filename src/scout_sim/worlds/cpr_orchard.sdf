<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="scout_world">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1.0</direction>
    </light>
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>1 1 1 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.512152</latitude_deg>
      <longitude_deg>22.426669</longitude_deg>
      <elevation>344</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <model name="orchard_geometry">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="orchard_world_link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <visual name="orchard_world_visual">
          <pose>0 0 0 0 0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://cpr_orchard_sdf14_world/meshes/orchard_world.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <visual name="orchard_trunks_visual">
          <pose>0 0 0 0 0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://cpr_orchard_sdf14_world/meshes/orchard_trunks.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <visual name="orchard_leaves_visual">
          <pose>0 0 0 0 0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://cpr_orchard_sdf14_world/meshes/orchard_leaves.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="orchard_world_collision">
          <pose>0 0 0 0 0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://cpr_orchard_sdf14_world/meshes/orchard_world.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="orchard_trunks_collision">
          <pose>0 0 0 0 0 1.5707963267948966</pose>
          <geometry>
            <mesh>
              <uri>model://cpr_orchard_sdf14_world/meshes/orchard_trunks.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-22.383711 -8.878892 23.248871 0 0.779645 1.336590</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </world>
</sdf>